{
    "name": "echo-fusion/contracts",
    "description": "Core interfaces and contracts for the EchoFusion framework, providing shared, standardized interfaces for cross-package interoperability and modular design.",
    "keywords": [
        "echoFusion",
        "contracts"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/echo-fusion/contracts",
    "authors": [
        {
            "name": "Amir Shadanfar",
            "email": "a.shadanfar.it@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/echo-fusion/contracts/issues",
        "source": "https://github.com/echo-fusion/contracts"
    },
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "echo-fusion/codestandard": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "EchoFusion\\Contracts\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "test": [
            "@cs-check"
        ],
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "cs-check": "php-cs-fixer fix --dry-run --diff"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
